{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!!**/dist", "!!.agents", "!!.claude"]
  },
  "formatter": {
    "indentStyle": "space",
    "includes": ["**", "!**/package.json", "!**/CHANGELOG.md"]
  },
  "linter": {
    "rules": {
      "complexity": {
        "noForEach": "error",
        "useDateNow": "error",
        "useFlatMap": "error",
        "useIndexOf": "error"
      },
      "correctness": {
        "useExhaustiveDependencies": {
          "level": "error",
          "options": {
            "hooks": [{ "name": "useAppDispatch", "stableResult": true }]
          }
        }
      },
      "style": {
        "noCommonJs": "error",
        "noSubstr": "error",
        "useArrayLiterals": "error",
        "useCollapsedIf": "error",
        "useConsistentArrayType": "error",
        "useConsistentTestIt": {
          "level": "error",
          "fix": "safe",
          "options": { "function": "test", "withinDescribe": "test" }
        },
        "useConst": "error",
        "useExplicitLengthCheck": "error",
        "useForOf": "error",
        "useNodejsImportProtocol": "error",
        "useNumberNamespace": "error",
        "useNumericSeparators": "error",
        "useThrowNewError": "error",
        "useTrimStartEnd": "error",
        "useUnifiedTypeSignatures": "error"
      },
      "nursery": {
        "useTailwindSortedClasses": { "level": "error", "fix": "safe" },
        "noTailwindRawColors": "error",
        "noTailwindLegacyUtilities": "error"
      },
      "suspicious": {
        "noDocumentCookie": "error",
        "noExplicitAny": "error",
        "useErrorMessage": "error",
        "useNumberToFixedDigitsArgument": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "tailwind": {
    "stylesheet": "src/UI/Layout/global.css"
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["src/UI/Base/**"],
      "linter": {
        "rules": {
          "nursery": {
            "useTailwindSortedClasses": "off",
            "noTailwindRawColors": "off",
            "noTailwindLegacyUtilities": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.{ts,tsx,mts,cts}"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConfusingVoidType": "off"
          }
        }
      }
    }
  ]
}
