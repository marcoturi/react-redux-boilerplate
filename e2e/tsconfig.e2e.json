{
  // Cucumber steps and support files, run by Node with its type stripping
  // (type-checked by tsc -b)
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "module": "nodenext",
    // What Node requires: relative imports with their .ts extension and
    // type-only imports marked as such (erasableSyntaxOnly comes from the root)
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  // Otherwise the empty "files" of the root would leave this project empty
  "include": ["."]
}
