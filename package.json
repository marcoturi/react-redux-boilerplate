{
  "name": "react-redux-boilerplate",
  "version": "1.7.52",
  "packageManager": "pnpm@10.34.5",
  "author": "Marco Turi <marco.turi@hotmail.it>",
  "description": "A production ready, batteries included starter template for Vite + React projects",
  "license": "MIT",
  "scripts": {
    "create:env": "node -r fs -e \"fs.copyFileSync('.env.example', '.env', fs.constants.COPYFILE_EXCL)\"",
    "dev": "vite",
    "start": "vite",
    "preview": "vite preview",
    "build": "tsc -b && vite build",
    "e2e": "TSX_TSCONFIG_PATH=./e2e/tsconfig.e2e.json SERVER_URL=http://localhost:5173 cucumber-js --retry 5 --parallel 5",
    "e2e:local": "TSX_TSCONFIG_PATH=./e2e/tsconfig.e2e.json SERVER_URL=http://localhost:5173 cucumber-js",
    "e2e:debug": "TSX_TSCONFIG_PATH=./e2e/tsconfig.e2e.json SERVER_URL=http://localhost:5173 cucumber-js --tags '@only' --fail-fast",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "type:check": "tsc -b",
    "check": "biome check && tsc -b",
    "check:fix": "biome check --write && tsc -b",
    "postinstall": "husky",
    "semantic-release": "semantic-release",
    "update:interactive": "pnpm update --interactive --latest"
  },
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=10.0.0"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.13.0",
    "@sentry/react": "11.10.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.1",
    "lucide-react": "1.65.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-error-boundary": "6.1.6",
    "react-redux": "9.3.1",
    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@cucumber/cucumber": "13.3.0",
    "@cucumber/messages": "34.2.1",
    "@playwright/test": "1.64.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "fs-extra": "11.4.1",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "semantic-release": "25.0.9",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
