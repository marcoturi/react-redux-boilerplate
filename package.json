{
  "name": "react-redux-boilerplate",
  "version": "2.0.4",
  "packageManager": "pnpm@12.18.0",
  "author": "Marco Turi <marco.turi@hotmail.it>",
  "description": "A production ready, batteries included starter template for Vite + React projects",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "create:env": "node -e \"const fs = require('node:fs'); fs.copyFileSync('.env.example', '.env', fs.constants.COPYFILE_EXCL)\"",
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsc -b && vite build",
    "e2e": "pnpm e2e:local --retry 1 --parallel 5",
    "e2e:local": "cucumber-js",
    "e2e:debug": "pnpm e2e:local --tags '@only' --fail-fast",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "biome format --write",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "type:check": "tsc -b",
    "check": "biome check && tsc -b",
    "check:fix": "biome check --write && tsc -b",
    "check:ci": "biome ci && tsc -b",
    "postinstall": "husky"
  },
  "engines": {
    "node": "^26.0.0",
    "pnpm": "^12.0.0"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.14.0",
    "@sentry/react": "11.11.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.1",
    "lucide-react": "1.71.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-redux": "9.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@biomejs/biome": "2.6.6",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@cucumber/cucumber": "13.3.0",
    "@playwright/test": "1.65.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@sentry/bundler-plugins": "11.11.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "husky": "9.1.7",
    "msw": "3.0.4",
    "semantic-release": "25.0.9",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
